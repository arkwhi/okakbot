from database import Database

db = Database()

# === Примеры твоих дополнительных команд ===

def id_handler(bot, message):
    # показать ID пользователя
    bot.reply_to(message, f"🆔 Твой Telegram ID: {message.from_user.id}")

def whoami_handler(bot, message):
    # показать инфо о пользователе
    user = message.from_user
    bot.reply_to(message, f"👤 Инфо о тебе:\n\n"
                          f"Имя: {user.first_name or ''} {user.last_name or ''}\n"
                          f"Username: @{user.username if user.username else '—'}\n"
                          f"ID: {user.id}")

def thanks_handler(bot, message):
    # триггер на "спасибо"
    bot.reply_to(message, f"Пожалуйста, {message.from_user.first_name}! 🙌")


# === Регистрируем хендлеры ===
def register_extra_handlers(bot):
    @bot.message_handler(commands=['id'])
    def handle_id(message): id_handler(bot, message)

    @bot.message_handler(commands=['whoami'])
    def handle_whoami(message): whoami_handler(bot, message)

    @bot.message_handler(func=lambda message: message.text and message.text.lower() == "спасибо")
    def handle_thanks(message): thanks_handler(bot, message)
